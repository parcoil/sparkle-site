{
	"name": "sparkle-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "npx tsx prebuild.ts && vite dev",
		"prebuild": "npx tsx prebuild.ts",
		"build": "npx tsx prebuild.ts && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^0.544.0",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.11",
		"bits-ui": "^2.22.0",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vite-plugin-lucide-preprocess": "^1.15.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.8",
		"posthog-js": "^1.455.2",
		"posthog-node": "^5.74.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
